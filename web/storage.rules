rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /sites/{siteId}/{fileName} {
      allow read: if true;

      // The trusted admin can always write (create or replace a photo).
      allow write: if request.auth != null || (
        // Public visitors may only upload a brand-new file -- never
        // overwrite an existing site's photo -- and only a reasonably
        // sized image.
        resource == null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*')
      );
    }
  }
}
